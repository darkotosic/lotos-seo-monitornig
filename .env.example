# Primer varijabli za LOKALNI TERMINAL; aplikacija ne učitava .env automatski.
# Setovati u PowerShell-u preko $env:IME="vrednost" ili u shell-u preko export.
# Nikada ne upisuj stvarne tajne u ovaj fajl i ne komituj .env.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/service-account.json
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SEO_DAILY_TELEGRAM_SUMMARY=false
